VITE_API_BASE_URL=http://localhost:8000

# Optional — Google Sign-In button on the auth screen. Same client id used
# by the mobile app's EXPO_PUBLIC_GOOGLE_CLIENT_ID (a "Web application"
# OAuth client — no package name/SHA-1 needed). Leave unset to hide the
# button.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
