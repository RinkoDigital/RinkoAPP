DATABASE_URL=postgresql+psycopg2://rinko:rinko@localhost:5432/rinko
JWT_SECRET=change-me-jwt-secret

# File storage — "local" (disk, fine for a single dev instance) or "s3"
# (any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Outbound email — "log" (default, nothing is delivered) or "smtp".
EMAIL_BACKEND=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@rinkodigital.com
# SMTP_USE_TLS=true
